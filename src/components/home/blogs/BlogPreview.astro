---
import InlineLink from '@components/shared/InlineLink.astro';
import SectionTitle from '@components/shared/SectionTitle.astro';
import type { Language } from '@lib/i18n/types';
import { useTranslatedPath, useTranslations } from '@lib/i18n/utils';
import FeaturedBlogPosts from './FeaturedBlogPosts.astro';

const { t: trUI } = useTranslations(Astro.currentLocale as Language);
const trPath = useTranslatedPath(Astro.currentLocale as Language);
const lang = Astro.currentLocale as Language;
---

<section class="mx-auto max-w-6xl px-8">
  <SectionTitle title={trUI('home.blog.title')} />
  <FeaturedBlogPosts lang={lang} />
  <div class="mt-10 text-center">
    <InlineLink href={trPath('/blog')}>
      {trUI('home.blog.viewAll')}
    </InlineLink>
  </div>
</section>
