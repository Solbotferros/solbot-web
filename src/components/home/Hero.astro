---
import SectionTitle from '@components/shared/SectionTitle.astro';
import ButtonLink from '@components/shared/ButtonLink.astro';
---

<section class="relative mt-20 min-h-[80vh] px-6 sm:px-8 lg:px-12">
  <div
    class="relative mx-auto grid min-h-[80vh] max-w-352 items-center lg:grid-cols-[1.15fr_0.25fr_1fr]"
  >
    <div
      class="border-border/60 bg-surface/90 relative z-10 col-start-1 row-start-1 max-w-4xl rounded-2xl border px-6 py-10 shadow-xl backdrop-blur-md sm:px-8 sm:py-12 lg:col-end-3 lg:px-10"
    >
      <SectionTitle
        titleTag="h1"
        title="Herrería y mobiliario metálico a medida"
        class="text-center lg:text-left"
        classTitle="text-4xl sm:text-6xl lg:text-7xl"
        subtitle="Diseñamos y fabricamos soluciones duraderas para viviendas, negocios y proyectos a medida, con un acabado profesional."
        classSubtitle="text-text/90"
      />

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <ButtonLink href="/contacto" variant="primary" size="lg"> Pide tu presupuesto </ButtonLink>

        <ButtonLink href="/proyectos" variant="secondary" size="lg"> Ver proyectos </ButtonLink>
      </div>
    </div>

    <div
      class="border-border/50 row-start-1 mt-10 hidden overflow-hidden rounded-2xl border shadow-xl lg:col-start-2 lg:col-end-4 lg:mt-0 lg:block lg:h-[72vh]"
    >
      <video
        autoplay
        loop
        muted
        playsinline
        class="h-full w-full object-cover object-center brightness-90 contrast-105 saturate-90"
      >
        <source src="/media/video-soldar.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </div>
  </div>
</section>
