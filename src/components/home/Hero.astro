---
import ButtonLink from '@components/shared/ButtonLink.astro';
import SectionTitle from '@components/shared/SectionTitle.astro';

import { useTranslatedPath, useTranslations, type Language } from '@lib/i18n/utils';

const lang = Astro.currentLocale as Language;
const { t } = useTranslations(lang);
const trPath = useTranslatedPath(lang);
---

<section class="relative -mt-24 min-h-[92vh] overflow-hidden lg:mt-8 lg:min-h-[80vh] lg:px-12">
  <div
    class="relative mx-auto grid min-h-[92vh] max-w-352 items-center lg:min-h-[80vh] lg:grid-cols-[1.15fr_0.15fr_1fr]"
  >
    <div
      class="border-border/60 bg-surface/88 relative z-10 col-start-1 row-start-1 mx-6 mt-24 rounded-2xl border px-6 py-10 shadow-xl backdrop-blur-md sm:mx-8 sm:px-8 sm:py-12 lg:col-end-3 lg:mx-0 lg:mt-0 lg:max-w-4xl lg:px-10"
    >
      <p class="text-primary mb-4 hidden text-sm font-semibold tracking-wide uppercase lg:block">
        {t('home.hero.eyebrow')}
      </p>

      <SectionTitle
        titleTag="h1"
        title={t('home.hero.title')}
        class="text-center lg:text-left"
        subtitle={t('home.hero.description')}
        classSubtitle="text-text/80 text-balance mx-auto"
      />

      <div class="flex flex-col gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <ButtonLink href={trPath('/contact')} variant="primary" size="lg">
          {t('home.hero.mainCTA')}
        </ButtonLink>

        <ButtonLink href={trPath('/projects')} variant="outline" size="lg">
          {t('home.hero.secondaryCTA')}
        </ButtonLink>
      </div>
    </div>

    <div
      class="lg:border-border/50 absolute inset-0 row-start-1 overflow-hidden lg:relative lg:col-start-2 lg:col-end-4 lg:h-[72vh] lg:rounded-2xl lg:border lg:shadow-xl"
    >
      <video
        autoplay
        loop
        muted
        playsinline
        class="h-full w-full object-cover object-center brightness-70 contrast-105 saturate-90 lg:brightness-90"
      >
        <source src="/media/video-soldar.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>

      <div
        class="absolute inset-0 bg-black/45 lg:bg-linear-to-l lg:from-black/40 lg:via-black/20 lg:to-transparent"
      >
      </div>
    </div>
  </div>
</section>
