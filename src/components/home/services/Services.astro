---
import ServiceImageCard from '@components/home/services/ServiceCard.astro';
import SectionTitle from '@components/shared/SectionTitle.astro';

import type { ServiceCardContent } from '@lib/business/services';
import { services } from '@lib/business/services';

import { translations } from '@lib/i18n/translations';
import { useTranslations, type Language } from '@lib/i18n/utils';

const { tn } = useTranslations(Astro.currentLocale as Language);

type HomeServicesSection = typeof translations.es.home.services;

const section = tn<HomeServicesSection>('home.services');
---

<section class="mx-auto max-w-6xl px-8">
  <SectionTitle title={section.title} subtitle={section.description} />

  <div class="mt-12 grid gap-6 md:grid-cols-2">
    {
      services.map((service) => {
        const content = section.items[service.key] as ServiceCardContent;

        return (
          <ServiceImageCard
            title={content.title}
            description={content.description}
            href={`/${service.slug}`}
            image={service.image}
          />
        );
      })
    }
  </div>
</section>
