---
import SBLogo from './SBLogo.astro';
import TextLogo from './TextLogo.astro';

export interface Props {
  class?: string;
  size?: 'xs' | 'sm' | 'md' | 'lg';
  showText?: boolean;
  responsive?: boolean;
}

const { class: className = '', size = 'md', showText = true, responsive = true } = Astro.props;

const staticSizes = {
  xs: {
    symbol: 'h-8',
    text: 'h-4',
    gap: 'gap-1.5',
  },
  sm: {
    symbol: 'h-9',
    text: 'h-4',
    gap: 'gap-2',
  },
  md: {
    symbol: 'h-10',
    text: 'h-5',
    gap: 'gap-2',
  },
  lg: {
    symbol: 'h-12',
    text: 'h-6',
    gap: 'gap-2.5',
  },
};

const responsiveSizes = {
  xs: {
    symbol: 'h-7 sm:h-8 md:h-9',
    text: 'h-3 sm:h-3.5 md:h-4',
    gap: 'gap-1.5 sm:gap-2',
  },
  sm: {
    symbol: 'h-8 sm:h-9 md:h-10',
    text: 'h-3.5 sm:h-4 md:h-4',
    gap: 'gap-2',
  },
  md: {
    symbol: 'h-9 sm:h-10 md:h-11 lg:h-12',
    text: 'h-4 sm:h-4 md:h-5 lg:h-5',
    gap: 'gap-1.5 md:gap-2',
  },
  lg: {
    symbol: 'h-10 sm:h-12 md:h-14 lg:h-16',
    text: 'h-5 sm:h-5 md:h-6 lg:h-6',
    gap: 'gap-2 md:gap-2.5',
  },
};

const selected = responsive ? responsiveSizes[size] : staticSizes[size];
---

<div class={`inline-flex items-center ${selected.gap} ${className}`}>
  <SBLogo class={selected.symbol} title="Solbot Ferros" />

  {
    showText && (
      <TextLogo
        class={selected.text}
        size={size}
        responsive={false}
        unstyledSize
        title="Solbot Ferros"
      />
    )
  }
</div>
