---
import WhatsappIcon from '@components/icons/WhatsappIcon.astro';
import businessInfo from '@lib/business/info';
import {
  formatSpanishPhone,
  formatWhatsappLink,
  getPhoneDisplay,
  getPhoneHref,
} from '@lib/business/utils';
import { useTranslatedPath, useTranslations, type Language } from '@lib/i18n/utils';

const lang = Astro.currentLocale as Language;
const { t: trUI } = useTranslations(lang);
const trPath = useTranslatedPath(lang);

interface Props {
  title?: string;
  description?: string;
  href?: string;
}

const {
  title = trUI('contactCta.title'),
  description = trUI('contactCta.description'),
  href = trPath('/contacto'),
} = Astro.props;

const phoneHref = getPhoneHref(businessInfo.phone);
const phoneDisplay = getPhoneDisplay(businessInfo.phone);
const formattedPhone = formatSpanishPhone(phoneDisplay);
const whatsappLink = formatWhatsappLink(businessInfo.phone);
---

<section
  class="border-border bg-surface-accent mx-auto mt-16 max-w-6xl rounded-2xl border p-6 sm:p-8"
>
  <p class="text-text-muted text-sm font-medium">
    {trUI('contactCta.eyebrow')}
  </p>

  <h2 class="text-text mt-2 text-2xl font-semibold tracking-tight">
    {title}
  </h2>

  <p class="text-text-muted mt-3 max-w-2xl leading-7">
    {description}
  </p>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <a
      href={href}
      class="bg-primary hover:bg-primary-hover text-on-primary inline-flex h-11 items-center justify-center rounded-full px-5 text-sm font-semibold"
    >
      {trUI('contactCta.primary')}
    </a>

    <a
      href={whatsappLink}
      class="border-border bg-surface text-text hover:bg-surface-hover inline-flex h-11 items-center justify-center gap-2 rounded-full border px-5 text-sm leading-5 font-semibold"
    >
      <WhatsappIcon aria-hidden="true" class="block size-6 shrink-0" />
      <span class="block">WhatsApp</span>
    </a>
  </div>

  <p class="text-text-muted mt-4 text-sm">
    {trUI('contactCta.phoneHint')}
    {' '}
    <a href={phoneHref} class="text-text font-medium hover:underline">
      {formattedPhone}
    </a>
  </p>
</section>
