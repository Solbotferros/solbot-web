---
import SectionTitle from '@components/shared/SectionTitle.astro';
import { getEntrySlug } from '@lib/content/entries';
import { useTranslatedPath, type Language } from '@lib/i18n/utils';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type ProjectEntry = CollectionEntry<'projects'>;

interface Props {
  title: string;
  projects: ProjectEntry[];
  viewAllHref: string;
  viewAllLabel: string;
}

const { title, projects, viewAllHref, viewAllLabel } = Astro.props;

const lang = Astro.currentLocale as Language;
const trPath = useTranslatedPath(lang);

if (projects.length === 0) {
  return;
}

const getProjectUrl = (project: CollectionEntry<'projects'>) => {
  return trPath(`/${lang}/projects/${getEntrySlug(project)}`);
};
---

<section class="mx-auto max-w-6xl px-4 pb-20">
  <div class="border-border border-t pt-10">
    <div class="mb-8 flex items-end justify-between gap-6">
      <SectionTitle titleTag="h2" title={title} />

      <a href={viewAllHref} class="text-primary text-sm font-semibold transition hover:opacity-70">
        {viewAllLabel} →
      </a>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => (
          <a href={getProjectUrl(project)} class="group bg-muted block overflow-hidden rounded-3xl">
            <div class="relative">
              <Image
                src={project.data.cover}
                alt={project.data.coverAlt}
                class="aspect-4/3 w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
              />

              <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/20 to-transparent" />

              <div class="absolute bottom-0 p-5 text-white">
                <p class="mb-2 text-[0.65rem] font-semibold tracking-wide uppercase opacity-80">
                  {project.data.location?.name}
                  {project.data.location?.name && project.data.service && ' · '}
                  {project.data.service}
                </p>

                <h3 class="text-lg leading-tight font-semibold">{project.data.title}</h3>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
