---
import ServiceImageCard from '@components/home/services/ServiceCard.astro';
import SectionTitle from '@components/shared/SectionTitle.astro';
import InlineLink from './InlineLink.astro';

import { useTranslatedPath, useTranslations, type Language } from '@lib/i18n/utils';
import { getCollection } from 'astro:content';

const lang = Astro.currentLocale as Language;
const { t } = useTranslations(lang);
const trPath = useTranslatedPath(lang);

const services = await getCollection(
  'services',
  ({ id, data }) => id.endsWith(`/${lang}`) && data.type === 'service',
);
services.sort((a, b) => a.data.order - b.data.order);

export interface ServicesProps {
  showHeader?: boolean;
  showViewAll?: boolean;
}
const { showHeader, showViewAll } = Astro.props;
---

<section id="home-services" class="mx-auto max-w-6xl px-8">
  {
    showHeader && (
      <SectionTitle title={t('home.services.title')} subtitle={t('home.services.description')} />
    )
  }

  <div class="mt-12 grid gap-6 md:grid-cols-2">
    {
      services.map((service) => {
        return (
          <ServiceImageCard
            title={service.data.title}
            description={service.data.description}
            href={trPath(`/servicios/${service.data.localizedSlug}`)}
            image={service.data.coverImage}
          />
        );
      })
    }
  </div>

  {
    showViewAll && (
      <div class="mt-12 text-center">
        <InlineLink href={trPath('/servicios')}>{t('home.services.viewAll')}</InlineLink>
      </div>
    )
  }
</section>
