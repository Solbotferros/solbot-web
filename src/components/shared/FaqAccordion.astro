---
import { Plus } from '@lucide/astro';
import SectionTitle from './SectionTitle.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  items: FaqItem[];
  class?: string;
}

const { title, items, class: className = '' } = Astro.props;

const accordionId = `faq-${Math.random().toString(36).slice(2, 9)}`;
---

{
  items.length > 0 && (
    <section class={className}>
      <SectionTitle title={title} subtitle="" class="mb-0" />

      <div
        class="divide-border/60 border-border/60 bg-surface/40 mt-6 divide-y rounded-2xl border"
        data-faq-accordion={accordionId}
      >
        {items.map((faq, index) => {
          const itemId = `${accordionId}-${index}`;

          return (
            <div class="faq-item" data-faq-item>
              <h3>
                <button
                  type="button"
                  class="faq-trigger font-display text-text flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-left text-lg font-semibold"
                  aria-expanded="false"
                  aria-controls={`${itemId}-content`}
                  id={`${itemId}-trigger`}
                  data-faq-trigger
                >
                  <span>{faq.question}</span>

                  <span class="faq-icon" aria-hidden="true">
                    <Plus class="fill-primary h-4 w-4 stroke-2" />
                  </span>
                </button>
              </h3>

              <div
                id={`${itemId}-content`}
                class="faq-content-grid"
                role="region"
                aria-labelledby={`${itemId}-trigger`}
                data-faq-content
              >
                <div class="faq-content-inner">
                  <p class="text-content-text px-5 pb-5 text-sm leading-relaxed">{faq.answer}</p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  )
}

<style>
  .faq-content-grid {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 260ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-content-inner {
    min-height: 0;
    overflow: hidden;
  }

  .faq-item[data-open='true'] .faq-content-grid {
    grid-template-rows: 1fr;
  }

  .faq-icon {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex: 0 0 auto;

    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--color-border) 70%, transparent);

    font-size: 1rem;
    line-height: 1;
    color: var(--color-primary);

    transition:
      transform 220ms ease,
      background-color 220ms ease,
      border-color 220ms ease;
  }

  .faq-trigger:hover .faq-icon {
    background: color-mix(in oklab, var(--color-primary) 12%, transparent);
    border-color: color-mix(in oklab, var(--color-primary) 45%, var(--color-border));
  }

  .faq-item[data-open='true'] .faq-icon {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-content-grid,
    .faq-icon {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-faq-accordion]').forEach((accordion) => {
    const items = accordion.querySelectorAll('[data-faq-item]');

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>('[data-faq-trigger]');

      trigger?.addEventListener('click', () => {
        const isOpen = item.getAttribute('data-open') === 'true';

        item.setAttribute('data-open', String(!isOpen));
        trigger.setAttribute('aria-expanded', String(!isOpen));
      });
    });
  });
</script>
