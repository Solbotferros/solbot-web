---
import SectionTitle from '@components/shared/SectionTitle.astro';

interface Point {
  label: string;
  value: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  points?: Point[];
  class?: string;
}

const { eyebrow, title, description, points = [], class: className = '' } = Astro.props;
---

<section class={`relative bg-surface/75 py-12 sm:py-14 lg:py-16 ${className}`}>
  <div class="mx-auto max-w-6xl px-6 sm:px-8 lg:px-12">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_1.1fr] lg:gap-16">
      <div class="relative">
        <div class="bg-primary absolute top-1 -left-6 hidden h-24 w-px sm:block lg:-left-8"></div>

        {
          eyebrow && (
            <p class="text-primary mb-4 text-xs font-semibold tracking-[0.22em] uppercase">
              {eyebrow}
            </p>
          )
        }

        <SectionTitle title={title} subtitle="" class="mb-0" />
      </div>

      <div>
        <p class="text-content-text text-text/90 max-w-3xl text-lg leading-relaxed sm:text-xl">
          {description}
        </p>

        {
          points.length > 0 && (
            <ul class="border-border/60 mt-10 grid gap-x-12 gap-y-6 border-t pt-8 sm:grid-cols-2">
              {points.map((point) => (
                <li>
                  <span class="text-primary text-xs font-semibold tracking-[0.16em] uppercase">
                    {point.label}
                  </span>
                  <p class="text-content-text text-text/90 mt-2 max-w-sm text-sm leading-relaxed">
                    {point.value}
                  </p>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>
</section>
