---
import { getEntryLang, getEntrySlug } from '@lib/content/entries';
import { useTranslatedPath, useTranslations, type Language } from '@lib/i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface LinkItem {
  title: string;
  description: string;
  href: string;
}

interface Props {
  service: CollectionEntry<'services'>;
  services: CollectionEntry<'services'>[];
  class?: string;
}

const { service, services, class: className = '' } = Astro.props;

const lang = Astro.currentLocale as Language;
const trPath = useTranslatedPath(lang);
const { t } = useTranslations(lang);

const currentSlug = getEntrySlug(service);

const sameLangServices = services.filter(
  (entry) => getEntryLang(entry) === lang && !entry.data.draft,
);

const genericService = sameLangServices.find(
  (entry) => entry.data.type === 'service' && entry.data.serviceKey === service.data.serviceKey,
);

const localizedVariants = sameLangServices
  .filter(
    (entry) =>
      entry.data.type === 'service-location' &&
      entry.data.serviceKey === service.data.serviceKey &&
      getEntrySlug(entry) !== currentSlug,
  )
  .sort((a, b) => a.data.order - b.data.order);

const sameLocationRelatedServices =
  service.data.type === 'service-location' && service.data.locationKey
    ? sameLangServices
        .filter(
          (entry) =>
            entry.data.type === 'service-location' &&
            entry.data.locationKey === service.data.locationKey &&
            entry.data.serviceKey !== service.data.serviceKey &&
            service.data.relatedServices.includes(entry.data.serviceKey),
        )
        .sort((a, b) => a.data.order - b.data.order)
    : [];

const toLinkItem = (entry: CollectionEntry<'services'>): LinkItem => ({
  title: entry.data.title,
  description: entry.data.description,
  href: trPath(`/servicios/${entry.data.localizedSlug}/`),
});

const genericLink: LinkItem | null =
  service.data.type === 'service-location' && genericService
    ? {
        title: genericService.data.title,
        description: genericService.data.description,
        href: trPath(`/servicios/${genericService.data.localizedSlug}/`),
      }
    : null;

const primaryItems: LinkItem[] =
  service.data.type === 'service'
    ? localizedVariants.map(toLinkItem)
    : [...(genericLink ? [genericLink] : []), ...localizedVariants.map(toLinkItem)];

const secondaryItems: LinkItem[] = sameLocationRelatedServices.map(toLinkItem);

const hasContent = primaryItems.length > 0 || secondaryItems.length > 0;

const heading =
  service.data.type === 'service'
    ? t('services.navigation.serviceTitle')
    : t('services.navigation.localizedTitle');

const description =
  service.data.type === 'service'
    ? t('services.navigation.serviceDescription')
    : t('services.navigation.localizedDescription');

const primaryLabel =
  service.data.type === 'service'
    ? t('services.navigation.availableAreas')
    : t('services.navigation.sameService');

const secondaryLabel = t('services.navigation.relatedInArea');
---

{
  hasContent && (
    <section class={`py-10 ${className}`}>
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
        <div>
          <p class="text-primary mb-3 text-sm font-semibold tracking-wide uppercase">
            {t('services.navigation.eyebrow')}
          </p>

          <h2 class="font-display text-text text-3xl leading-tight font-semibold">{heading}</h2>

          <p class="text-content-text mt-4 leading-relaxed">{description}</p>
        </div>

        <div class="space-y-10">
          {primaryItems.length > 0 && (
            <div>
              <h3 class="text-text mb-2 text-sm font-semibold tracking-wide uppercase">
                {primaryLabel}
              </h3>

              <div class="divide-border/60 divide-y">
                {primaryItems.map((item) => (
                  <a
                    href={item.href}
                    class="group grid gap-3 py-5 first:pt-0 last:pb-0 sm:grid-cols-[1fr_auto]"
                  >
                    <div>
                      <h4 class="text-text group-hover:text-primary text-xl font-semibold transition-colors">
                        {item.title}
                      </h4>

                      <p class="text-text-muted mt-2 text-base leading-7">{item.description}</p>
                    </div>

                    <span
                      class="border-border/60 text-primary group-hover:bg-primary group-hover:text-primary-contrast mt-1 inline-flex size-9 items-center justify-center rounded-full border transition-colors"
                      aria-hidden="true"
                    >
                      →
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )}

          {secondaryItems.length > 0 && (
            <div>
              <h3 class="text-text mb-2 text-sm font-semibold tracking-wide uppercase">
                {secondaryLabel}
              </h3>

              <div class="divide-border/60 divide-y">
                {secondaryItems.map((item) => (
                  <a
                    href={item.href}
                    class="group grid gap-3 py-5 first:pt-0 last:pb-0 sm:grid-cols-[1fr_auto]"
                  >
                    <div>
                      <h4 class="text-text group-hover:text-primary text-xl font-semibold transition-colors">
                        {item.title}
                      </h4>

                      <p class="text-text-muted mt-2 text-base leading-7">{item.description}</p>
                    </div>

                    <span
                      class="border-border/60 text-primary group-hover:bg-primary group-hover:text-primary-contrast mt-1 inline-flex size-9 items-center justify-center rounded-full border transition-colors"
                      aria-hidden="true"
                    >
                      →
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  )
}
