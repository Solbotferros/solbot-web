---
import SectionTitle from '@components/shared/SectionTitle.astro';
import { translations } from '@lib/i18n/translations';

import { useTranslations, type Language } from '@lib/i18n/utils';

const { tn } = useTranslations(Astro.currentLocale as Language);
type SeoTextTranslations = typeof translations.es.services.seo;
const seoTranslations = tn<SeoTextTranslations>('services.seo');
---

<section class="mx-auto max-w-6xl px-8">
  <div class="max-w-4xl">
    <SectionTitle titleTag="h2" title={seoTranslations.title} />
    <div class="text-text-muted mt-6 space-y-5 text-sm leading-8 md:text-base">
      {seoTranslations.paragraphs.map((text) => <p>{text}</p>)}
    </div>
  </div>
</section>
