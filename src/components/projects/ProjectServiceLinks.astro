---
import { getEntryLang } from '@lib/content/entries';
import { useTranslatedPath, useTranslations, type Language } from '@lib/i18n/utils';
import { ArrowRight } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

interface LinkItem {
  title: string;
  description: string;
  href: string;
}

interface Props {
  project: CollectionEntry<'projects'>;
  services: CollectionEntry<'services'>[];
  class?: string;
}

const { project, services, class: className = '' } = Astro.props;

const lang = Astro.currentLocale as Language;
const trPath = useTranslatedPath(lang);
const { t } = useTranslations(lang);

const sameLangServices = services.filter(
  (entry) => getEntryLang(entry) === lang && !entry.data.draft,
);

const projectLocationKey = project.data.location?.slug;

const findBestServiceEntry = (serviceKey: string) => {
  const localizedMatch =
    projectLocationKey &&
    sameLangServices.find(
      (entry) =>
        entry.data.type === 'service-location' &&
        entry.data.serviceKey === serviceKey &&
        entry.data.locationKey === projectLocationKey,
    );

  if (localizedMatch) return localizedMatch;

  return sameLangServices.find(
    (entry) => entry.data.type === 'service' && entry.data.serviceKey === serviceKey,
  );
};

const relatedServiceLinks: LinkItem[] = project.data.serviceKeys
  .map((serviceKey) => findBestServiceEntry(serviceKey))
  .filter((entry): entry is CollectionEntry<'services'> => Boolean(entry))
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    href: trPath(`/servicios/${entry.data.localizedSlug}/`),
  }));

const hasContent = relatedServiceLinks.length > 0;
---

{
  hasContent && (
    <section class={`py-10 ${className}`}>
      <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
        <div>
          <p class="text-primary mb-3 text-sm font-semibold tracking-wide uppercase">
            {t('projects.relatedServicesEyebrow')}
          </p>

          <h2 class="font-display text-text text-3xl leading-tight font-semibold">
            {t('projects.relatedServicesTitle')}
          </h2>

          <p class="text-content-text mt-4 leading-relaxed">
            {t('projects.relatedServicesDescription')}
          </p>
        </div>

        <div class="divide-border/60 divide-y">
          {relatedServiceLinks.map((item) => (
            <a href={item.href} class="group block py-5 first:pt-0 last:pb-0">
              <div class="grid grid-cols-[1fr_auto] items-start gap-4">
                <h3 class="text-text group-hover:text-primary text-xl font-semibold transition-colors">
                  {item.title}
                </h3>

                <span
                  class="border-border/60 text-primary group-hover:bg-glow group-hover:text-text mt-1 inline-flex size-9 shrink-0 items-center justify-center rounded-full border transition-colors"
                  aria-hidden="true"
                >
                  <ArrowRight class="size-4" />
                </span>
              </div>

              <p class="text-text-muted mt-2 text-base leading-7">{item.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
