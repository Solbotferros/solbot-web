---
import Icon from './Icon.astro';

interface Props {
  size?: string | number;
  width?: string | number;
  height?: string | number;
  class?: string;
  title?: string;
  strokeWidth?: string | number;
}

const { size = 24, width, height, class: className = '', title, strokeWidth = 2 } = Astro.props;
---

<Icon
  size={size}
  width={width}
  height={height}
  class={className}
  title={title}
  strokeWidth={strokeWidth}
>
  <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
</Icon>
