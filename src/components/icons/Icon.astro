---
interface Props {
  class?: string;
  viewBox?: string;
  fill?: string;
  stroke?: string;
  strokeWidth?: string | number;
  ariaHidden?: boolean;
  title?: string;
}

const {
  class: className = '',
  viewBox = '0 0 24 24',
  fill = 'none',
  stroke = 'currentColor',
  strokeWidth = 2,
  title,
} = Astro.props;

const ariaHidden = Astro.props.ariaHidden ?? !title;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  fill={fill}
  stroke={stroke}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={ariaHidden ? 'true' : undefined}
  role={ariaHidden ? undefined : 'img'}
>
  {title && <title>{title}</title>}
  <slot />
</svg>
