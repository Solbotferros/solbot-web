---
import SectionTitle from '@components/shared/SectionTitle.astro';
import type { translations } from '@lib/i18n/translations';
import { useTranslations, type Language } from '@lib/i18n/utils';
import ServiceAreaMap from './ServiceAreaMap.astro';

const lang = Astro.currentLocale as Language;
const { tn } = useTranslations(lang);

type ServiceAreasSection = typeof translations.es.home.serviceAreas;
const section = tn<ServiceAreasSection>('home.serviceAreas');
---

<section class="mx-auto max-w-6xl px-8">
  <div class="grid gap-12 lg:grid-cols-[1fr_0.9fr] lg:items-center">
    <div>
      <SectionTitle title={section.title} subtitle={section.subtitle} />

      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {
          section.areas.map((area) => (
            <li class="text-text flex items-center gap-3 text-sm font-semibold">
              <span class="bg-primary size-2 rounded-full" />
              {area}
            </li>
          ))
        }
      </ul>

      <p class="text-text-muted mt-6 max-w-xl text-sm leading-6">
        {section.note}
      </p>
    </div>

    <ServiceAreaMap title={section.mapTitle} />
  </div>
</section>
