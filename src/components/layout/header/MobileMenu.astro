---
import ButtonLink from '@components/shared/ButtonLink.astro';
import LanguageSelector from '@components/shared/LanguageSelector.astro';
import ThemeToggle from '@components/shared/ThemeToggle.astro';
import { getEntrySlug } from '@lib/content/entries';
import type { translations } from '@lib/i18n/translations';
import type { Language } from '@lib/i18n/types';
import { useTranslatedPath, useTranslations } from '@lib/i18n/utils';
import { buildNavigation } from '@lib/navigation';
import { ChevronDown } from '@lucide/astro';
import { getCollection } from 'astro:content';

const currentLocale = Astro.currentLocale as Language;
const trPath = useTranslatedPath(currentLocale);
const { t, tn } = useTranslations(currentLocale);

const navigation = await buildNavigation(currentLocale);

type NavTranslationsType = typeof translations.es.nav;
const navTranslations = tn<NavTranslationsType>('nav');

const services = await getCollection('services', ({ id }) => id.endsWith(`/${currentLocale}`));
services.sort((a, b) => a.data.order - b.data.order);
---

<div
  id="mobile-menu"
  class="mobile-menu bg-bg-subtle absolute inset-x-0 top-[calc(100%-0.75rem)] z-120 rounded-b-xl px-6 xl:hidden"
  data-mobile-menu
>
  <div class="mobile-menu-inner">
    <div
      class="mobile-menu-content border-border mx-auto mt-4 max-w-md space-y-8 border-t pt-6 pb-6 sm:max-w-lg md:max-w-xl"
    >
      <nav aria-label={t('header.mobileMenu.ariaLabel')}>
        <ul class="space-y-2">
          {
            navigation.map((item) => {
              const label = navTranslations[item.key as keyof NavTranslationsType] || item.key;

              if (item.key === 'services') {
                return (
                  <li>
                    <button
                      type="button"
                      class="services-accordion-trigger hover:bg-surface-elevated flex w-full cursor-pointer items-center justify-between rounded-lg px-3 py-3 text-sm font-semibold transition-colors"
                      data-services-accordion-trigger
                      aria-expanded="false"
                      aria-controls="mobile-services-panel"
                    >
                      <span>{label}</span>
                      <ChevronDown class="size-4 transition-transform" data-services-chevron />
                    </button>

                    <div
                      id="mobile-services-panel"
                      class="services-accordion-panel"
                      data-services-accordion-panel
                    >
                      <ul class="space-y-1 pt-2 pl-3">
                        <li>
                          <a
                            href={item.href}
                            class="text-primary block rounded-lg px-3 py-2 text-sm font-semibold"
                          >
                            {t('header.servicesPanel.viewAll')}
                          </a>
                        </li>

                        {services.map((service) => {
                          const slug = getEntrySlug(service);

                          return (
                            <li>
                              <a
                                href={trPath(`/servicios/${slug}`)}
                                class="text-text-muted hover:text-primary block rounded-lg px-3 py-2 text-sm transition-colors"
                              >
                                {service.data.title}
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  </li>
                );
              }

              return (
                <li>
                  <a
                    href={item.href}
                    class="hover:bg-surface-elevated block rounded-lg px-3 py-3 text-sm font-semibold transition-colors"
                  >
                    {label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <ButtonLink href={trPath('/contacto')} variant="primary" size="sm" class="w-full md:hidden">
        {t('home.hero.mainCTA')}
      </ButtonLink>

      <div class="border-border flex items-center justify-between border-t pt-5 lg:hidden">
        <LanguageSelector />
        <ThemeToggle />
      </div>
    </div>
  </div>
</div>

<style>
  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    pointer-events: none;
    box-shadow: none;
    border: none;

    transition:
      grid-template-rows 280ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 280ms ease,
      visibility 0s linear 280ms;
  }

  .mobile-menu-inner {
    min-height: 0;
    overflow: hidden;
  }

  :global(.header-shell[data-mobile-open='true']) .mobile-menu {
    grid-template-rows: 1fr;
    visibility: visible;
    pointer-events: auto;

    box-shadow:
      0 36px 48px -24px rgb(0 0 0 / 0.22),
      0 16px 24px -20px rgb(0 0 0 / 0.14);

    transition:
      grid-template-rows 280ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 280ms ease,
      visibility 0s;
  }

  .mobile-menu-content {
    border-top: 1px solid transparent;
  }

  :global(.header-shell[data-mobile-open='true']) .mobile-menu-content {
    border-top-color: var(--color-border);
  }

  .services-accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 240ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .services-accordion-panel > ul {
    min-height: 0;
    overflow: hidden;
  }

  .services-accordion-panel[data-open='true'] {
    grid-template-rows: 1fr;
  }

  .services-accordion-trigger[aria-expanded='true'] {
    background: var(--color-surface-elevated);
  }

  .services-accordion-trigger[aria-expanded='true'] [data-services-chevron] {
    transform: rotate(180deg);
  }
</style>

<script>
  const trigger = document.querySelector('[data-services-accordion-trigger]');
  const panel = document.querySelector('[data-services-accordion-panel]');

  trigger?.addEventListener('click', () => {
    const isOpen = trigger.getAttribute('aria-expanded') === 'true';

    trigger.setAttribute('aria-expanded', String(!isOpen));

    if (isOpen) {
      panel?.removeAttribute('data-open');
    } else {
      panel?.setAttribute('data-open', 'true');
    }
  });
</script>
