---
import InlineLink from '@components/shared/InlineLink.astro';
import { getEntrySlug } from '@lib/content/entries';
import { useTranslatedPath, type Language } from '@lib/i18n/utils';
import { getCollection } from 'astro:content';

const currentLocale = Astro.currentLocale as Language;
const trPath = useTranslatedPath(currentLocale);

const services = await getCollection('services', ({ id }) => id.endsWith(`/${currentLocale}`));
services.sort((a, b) => a.data.order - b.data.order);
---

<div class="grid gap-10 lg:grid-cols-[0.75fr_2fr]">
  <div class="max-w-xs">
    <p class="text-text-muted text-xs font-semibold tracking-[0.2em] uppercase">Servicios</p>

    <h2 class="mt-3 text-xl font-semibold">Soluciones metálicas a medida</h2>

    <p class="text-text-muted mt-3 text-sm leading-6">
      Diseño, fabricación e instalación para viviendas, negocios e industria.
    </p>

    <div class="mt-5">
      <InlineLink href={trPath('/servicios')}>Ver todos</InlineLink>
    </div>
  </div>

  <ul class="grid auto-rows-fr gap-3 sm:grid-cols-2">
    {
      services.map((service) => {
        const slug = getEntrySlug(service);

        return (
          <li class="h-full">
            <a
              href={trPath(`/servicios/${slug}`)}
              class="group border-border/60 hover:border-primary/40 hover:bg-surface-elevated/60 flex h-full min-h-30 flex-col rounded-xl border p-4 transition-colors"
            >
              <p class="group-hover:text-primary font-semibold transition-colors">
                {service.data.title}
              </p>

              {service.data.description && (
                <p class="text-text-muted mt-1.5 line-clamp-3 text-sm leading-6">
                  {service.data.description}
                </p>
              )}
            </a>
          </li>
        );
      })
    }
  </ul>
</div>
