---
import InlineLink from '@components/shared/InlineLink.astro';
import { useTranslatedPath, useTranslations, type Language } from '@lib/i18n/utils';
import { buildNavigation } from '@lib/navigation/build';

const lang = Astro.currentLocale as Language;
const trPath = useTranslatedPath(lang);
const { t } = useTranslations(lang);

const navigation = await buildNavigation(lang);
const services = navigation.find((item) => item.key === 'services')?.children || [];
services.sort((a, b) => a.data.order - b.data.order);
---

<div class="grid gap-10 lg:grid-cols-[0.75fr_2fr]">
  <div class="max-w-xs">
    <p class="text-text-muted text-xs font-semibold tracking-[0.2em] uppercase">
      {t('header.servicesPanel.eyebrow')}
    </p>

    <h2 class="mt-3 text-xl font-semibold">{t('header.servicesPanel.title')}</h2>

    <p class="text-text-muted mt-3 text-sm leading-6">
      {t('header.servicesPanel.description')}
    </p>

    <div class="mt-5">
      <InlineLink href={trPath('/servicios')}>{t('header.servicesPanel.viewAll')}</InlineLink>
    </div>
  </div>

  <ul class="grid auto-rows-fr gap-3 sm:grid-cols-2">
    {
      services.map((service) => {
        return (
          <li class="h-full">
            <a
              href={service.href}
              class="group border-border/60 hover:border-primary/40 hover:bg-surface-elevated/60 flex h-full min-h-30 flex-col rounded-xl border p-4 transition-colors"
            >
              <p class="group-hover:text-primary font-semibold transition-colors">
                {service.data.title}
              </p>

              {service.data.description && (
                <p class="text-text-muted mt-1.5 line-clamp-3 text-sm leading-6">
                  {service.data.description}
                </p>
              )}
            </a>
          </li>
        );
      })
    }
  </ul>
</div>
