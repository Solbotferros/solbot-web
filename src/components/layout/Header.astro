---
import LogoWithText from '@components/brand/LogoWithText.astro';
import ButtonLink from '@components/shared/ButtonLink.astro';
import LanguageSelector from '@components/shared/LanguageSelector.astro';
import ThemeToggle from '@components/shared/ThemeToggle.astro';

import { useTranslatedPath, useTranslations, type Language } from '@lib/i18n/utils';

const currentLocale = Astro.currentLocale as Language;
const trPath = useTranslatedPath(currentLocale);
const { t } = useTranslations(currentLocale);
---

<header class="sticky top-0 z-100">
  <div class="bg-bg/5 p-4 pb-0 backdrop-blur-xl">
    <div
      class="bg-bg-subtle mx-auto grid grid-cols-[1fr_auto] items-center gap-4 rounded-lg px-6 py-4 shadow-xl"
    >
      <a href={trPath('/')}>
        <LogoWithText size="sm" />
      </a>

      <div class="flex items-center gap-6">
        <ButtonLink href={trPath('/contacto')} variant="primary" size="sm" class="mr-4">
          {t('home.hero.mainCTA')}
        </ButtonLink>

        <div class="bg-border h-12 w-px"></div>

        <LanguageSelector />
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
