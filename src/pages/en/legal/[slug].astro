---
import LegalPage from '@views/LegalPage.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

// Genera páginas en build
export async function getStaticPaths() {
  const pages = await getCollection('legal', ({ id }) => id.endsWith('/en'));

  return pages.map((page: CollectionEntry<'legal'>) => {
    const slug = page.data.localizedSlug;

    return {
      params: { slug },
      props: { page },
    };
  });
}

type Props = {
  page: CollectionEntry<'legal'>;
};

const { page } = Astro.props;

// Render MDX como componente
const { Content } = await render(page);

// Metadatos vienen del frontmatter
const { title, description, updatedAt } = page.data;
---

<LegalPage title={title} description={description} updatedAt={updatedAt} Content={Content} />
