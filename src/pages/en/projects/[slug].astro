---
import { getEntrySlug } from '@lib/content/entries';
import ProjectDetailPage from '@views/ProjectDetailPage.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

// Genera páginas en build
export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ id }) => id.endsWith('/en'));

  return projects.map((project: CollectionEntry<'projects'>) => {
    const slug = getEntrySlug(project);

    return {
      params: { slug },
      props: { project },
    };
  });
}

type Props = {
  project: CollectionEntry<'projects'>;
};

const { project } = Astro.props;

// Render MDX como componente
const { Content } = await render(project);

// Metadatos vienen del frontmatter
const { title, cover, coverAlt, sector, location, service } = project.data;
---

<ProjectDetailPage project={project} Content={Content} />
