---
import Footer from '@components/layout/Footer.astro';
import Header from '@components/layout/Header.astro';

import '@styles/global.css';

import type { Language } from '@lib/i18n/types';

// Ensures the router is ready and route segments are built before rendering the layout
import { ensureRouterReady } from '@lib/i18n/router';
await ensureRouterReady();

import { translatePathname } from '@lib/i18n/utils';

const { title, description } = Astro.props;

import { locales, defaultLang } from '@lib/i18n/locales';

const lang = Astro.currentLocale as Language;

const fullTitle = title ? `${title} | Solbot Ferros` : 'Solbot Ferros';

// SEO for multilingual sites: Generate alternate URLs for each locale
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site?.origin ?? 'https://solbot-ferros.es';
// Build alternate URLs by translating the current path for each locale
const alternateUrls = Object.fromEntries(
  locales.map((l) => [l, `${siteUrl}${translatePathname(currentPath, l)}`]),
);
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <!-- GENERAL META TAGS -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- SEO: canonical link -->
    <link rel="canonical" href={alternateUrls[lang]} />

    <!-- SEO: hreflang alternates for multilingual site -->
    {locales.map((l) => <link rel="alternate" hreflang={l} href={alternateUrls[l]} />)}

    <!-- SEO: x-default alternate -->
    <link rel="alternate" hreflang="x-default" href={alternateUrls[defaultLang]} />

    <!-- SCRIPT TEMA -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches;

        const theme = stored === 'light' || stored === 'dark' ? stored : system ? 'dark' : 'light';

        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;

    display: grid;
    grid-template-rows: auto 1fr auto;
  }
</style>
