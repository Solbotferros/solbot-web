---
import Layout from '@layouts/Layout.astro';

import { formatLongDate, useTranslations, type Language } from '@lib/i18n/utils';

const { t: trUI } = useTranslations(Astro.currentLocale as Language);

interface Props {
  title: string;
  description?: string;
  updatedAt?: Date;
}

const { title, description, updatedAt } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="mx-auto mt-16 max-w-3xl px-8 sm:px-12 lg:px-16">
    <header class="mb-10">
      <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl lg:text-4xl">{title}</h1>

      {
        updatedAt && (
          <p class="text-text/60 mt-2 text-sm">
            {trUI('time.lastUpdated')}: {formatLongDate(updatedAt, Astro.currentLocale as Language)}
          </p>
        )
      }
    </header>

    <div
      class="prose prose-legal prose-headings:tracking-tight prose-h2:mt-10 prose-h2:mb-4 prose-h3:mt-8 prose-h3:mb-3 prose-p:leading-7 prose-li:leading-7 prose-a:no-underline hover:prose-a:underline max-w-none"
    >
      <slot />
    </div>
  </div>
</Layout>
