---
import Layout from '@layouts/Layout.astro';

import ContactForm from '@components/contact/ContactForm.astro';
import ContactHero from '@components/contact/ContactHero.astro';
import ContactInfo from '@components/contact/ContactInfo.astro';

import { ensureRouterReady } from '@lib/i18n/router';
await ensureRouterReady();
---

<Layout
  title="Contacto y presupuestos"
  description="Pide presupuesto para trabajos de carpintería metálica, estructuras metálicas y soldadura en Barcelona, Maresme y Vallès."
>
  <section class="md:space-y-6 lg:space-y-12">
    <div class="mx-auto max-w-6xl">
      <ContactHero />
      <ContactForm />
    </div>
    <div class="mx-auto max-w-7xl">
      <ContactInfo />
    </div>
  </section>
</Layout>
