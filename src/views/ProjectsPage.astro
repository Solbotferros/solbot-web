---
import Layout from '@layouts/Layout.astro';
import { getEntryLang } from '@lib/content/entries';
import type { Language } from '@lib/i18n/types';
import { getCollection } from 'astro:content';

import ProjectsGallery from '@components/projects/ProjectsGallery.astro';
import ProjectsHero from '@components/projects/ProjectsHero.astro';

const lang = Astro.currentLocale as Language;

const projects = await getCollection('projects', (entry) => getEntryLang(entry) === lang);

projects.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Proyectos de herrería y estructuras metálicas"
  description="Trabajos realizados de carpintería metálica, estructuras, escaleras, barandillas y soluciones metálicas a medida."
>
  <ProjectsHero />
  <ProjectsGallery projects={projects} />
</Layout>
