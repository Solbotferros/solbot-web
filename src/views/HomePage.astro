---
import Layout from '@layouts/Layout.astro';

import BlogPreview from '@components/home/blogs/BlogPreview.astro';
import ContactCTA from '@components/home/ContactCTA.astro';
import Hero from '@components/home/Hero.astro';
import SeoTextSection from '@components/home/HomeSeoText.astro';
import Projects from '@components/home/Projects.astro';
import Sectors from '@components/home/Sectors.astro';
import ServiceAreas from '@components/home/ServiceAreas.astro';
import Services from '@components/home/services/Services.astro';
import WhyUs from '@components/home/WhyUs.astro';

import { useTranslations, type Language } from '@lib/i18n/utils';

const { t } = useTranslations(Astro.currentLocale as Language);
---

<Layout title={t('home.title')} description={t('home.description')}>
  <div class="space-y-32">
    <Hero />
    <Services />
    <WhyUs />
    <Sectors />
    <Projects />
    <ServiceAreas />
    <SeoTextSection />
    <ContactCTA />
    <BlogPreview />
  </div>
</Layout>
