---
import Layout from '@layouts/Layout.astro';

import BlogPreview from '@components/home/blogs/BlogPreview.astro';
import Hero from '@components/home/Hero.astro';
import SeoTextSection from '@components/home/HomeSeoText.astro';
import Projects from '@components/home/ProjectsPreview.astro';
import Sectors from '@components/home/Sectors.astro';
import WhyUs from '@components/home/WhyUs.astro';
import ServiceAreas from '@components/sections/serviceArea/ServiceArea.astro';
import ContactCta from '@components/shared/ContactCta.astro';
import Services from '@components/shared/ServicesGrid.astro';

// Ensures the router is ready and route segments are built before rendering the components
import { ensureRouterReady } from '@lib/i18n/router';
await ensureRouterReady();

import Testimonials from '@components/home/Testimonials.astro';
import { useTranslations, type Language } from '@lib/i18n/utils';

const { t } = useTranslations(Astro.currentLocale as Language);
---

<Layout title={t('home.title')} description={t('home.description')}>
  <div class="space-y-24 md:space-y-32">
    <Hero />
    <Services showHeader={true} showViewAll={true} />
    <WhyUs />
    <Sectors />
    <Projects />
    <Testimonials />
    <ServiceAreas />
    <SeoTextSection />
    <div class="mx-auto max-w-6xl px-8">
      <ContactCta />
    </div>
    <BlogPreview />
  </div>
</Layout>
