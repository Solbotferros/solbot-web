---
import ServiceApproach from '@components/services/ServiceApproach.astro';
import ServiceContactAside from '@components/services/ServiceContactAside.astro';
import ServiceHero from '@components/services/ServiceHero.astro';
import RelatedProjects from '@components/shared/RelatedProjects.astro';
import Layout from '@layouts/Layout.astro';
import { useTranslatedPath, useTranslations, type Language } from '@lib/i18n/utils';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import { ensureRouterReady } from '@lib/i18n/router';
ensureRouterReady();

interface Props {
  service: CollectionEntry<'services'>;
  Content: any;
}

const { service, Content } = Astro.props;

const { title, description, coverImage, coverAlt, approach, cta, seoTitle } = service.data;

const lang = Astro.currentLocale as Language;
const trPath = useTranslatedPath(lang);
const { t } = useTranslations(lang);

const allProjects = await getCollection('projects', (entry) =>
  entry.id.endsWith(`/${Astro.currentLocale}`),
);

const relatedProjects = allProjects
  .map((project) => {
    const score = project.data.serviceKeys.reduce((total, key) => {
      if (key === service.data.serviceKey) return total + 3;
      if (service.data.relatedServices?.includes(key)) return total + 1;
      return total;
    }, 0);

    return { project, score };
  })
  .filter(({ score }) => score > 0)
  .sort(
    (a, b) =>
      b.score - a.score || Number(b.project.data.featured) - Number(a.project.data.featured),
  )
  .slice(0, 3)
  .map(({ project }) => project);
---

<Layout title={seoTitle ?? title} description={description}>
  <main class="space-y-24">
    <ServiceHero
      title={title}
      description={description}
      coverImage={coverImage}
      coverAlt={coverAlt}
    />

    <div class="mx-auto max-w-6xl px-8 py-16 sm:px-12 lg:px-16">
      <ServiceApproach approach={approach} />
    </div>

    <section class="mx-auto max-w-3xl px-6 lg:max-w-6xl lg:px-12">
      <div class="grid gap-x-16 gap-y-12 lg:grid-cols-[minmax(0,1fr)_380px]">
        <article class="min-w-0">
          <div class="prose prose-content-text max-w-none">
            <Content />
          </div>
        </article>

        <aside class="mx-auto lg:sticky lg:top-34 lg:self-start">
          <ServiceContactAside title={cta?.title} description={cta?.description} />
        </aside>
      </div>
    </section>

    <div id="service-related-projects" class="linked-section">
      <RelatedProjects
        title={t('services.relatedProjects')}
        projects={relatedProjects}
        viewAllHref={trPath(`projects/`)}
        viewAllLabel={t('services.allProjects')}
      />
    </div>
  </main>
</Layout>
