---
import ContactCta from '@components/shared/ContactCta.astro';
import RelatedProjects from '@components/shared/RelatedProjects.astro';
import Layout from '@layouts/Layout.astro';
import type { translations } from '@lib/i18n/translations';
import type { Language } from '@lib/i18n/types';
import { useTranslatedPath, useTranslations } from '@lib/i18n/utils';

import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

import ProjectServiceLinks from '@components/projects/ProjectServiceLinks.astro';
import Lightbox from '@components/shared/Lightbox.astro';
import SectionTitle from '@components/shared/SectionTitle.astro';
import { ensureRouterReady } from '@lib/i18n/router';
await ensureRouterReady();

interface Props {
  project: CollectionEntry<'projects'>;
  Content: any; // El componente MDX renderizado
}

const lang = Astro.currentLocale as Language;
const trPath = useTranslatedPath(lang);
const { tn, t } = useTranslations(lang);
type SectorsSection = typeof translations.es.home.sectors;
const sectorsTranslations = tn<SectorsSection>('home.sectors');

const { project, Content } = Astro.props;
const { title, location, service, sector, cover, coverAlt, description, gallery } = project.data;

const allProjects = await getCollection(
  'projects',
  (entry) => entry.id.endsWith(`/${Astro.currentLocale}`) && entry.id !== project.id,
);

const relatedProjects = allProjects
  .filter((entry) => entry.data.sector === sector || entry.data.service === service)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);

const allServices = await getCollection('services', (entry) =>
  entry.id.endsWith(`/${Astro.currentLocale}`),
);

const breadcrumbs = [
  { label: t('nav.home'), href: trPath('/') },
  { label: t('nav.projects'), href: trPath('/projects/') },
  { label: title },
];

const galleryItems = gallery ?? [];

const lightboxId = `project-lightbox-${project.id}`;

const lightboxImages = await Promise.all(
  [{ image: cover, alt: coverAlt }, ...galleryItems].map(async (item) => {
    const optimizedImage = await getImage({
      src: item.image,
      width: 1800,
      format: 'webp',
    });

    return {
      src: optimizedImage.src,
      alt: item.alt,
    };
  }),
);
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
  <article>
    <section class="mx-auto max-w-6xl px-4 pt-16 pb-10 md:pt-24 md:pb-16">
      <header class="max-w-5xl">
        {
          location && (
            <p class="text-primary mb-4 text-sm font-semibold tracking-[0.18em] uppercase">
              {location?.name} · {service}
            </p>
          )
        }

        <SectionTitle titleTag="h1" title={title} subtitle={description} />
      </header>
    </section>

    <section class="mx-auto grid max-w-6xl gap-10 px-4 pb-20 md:grid-cols-[1.05fr_0.95fr] md:pb-24">
      <aside class="md:sticky md:top-36 md:self-start">
        <dl class="border-border mb-5 grid grid-cols-3 gap-4 border-y py-4 text-sm">
          {
            location && (
              <div>
                <dt class="text-text-muted text-xs">Ubicación</dt>
                <dd class="text-text mt-1 font-medium">{location?.name}</dd>
              </div>
            )
          }

          {
            service && (
              <div>
                <dt class="text-text-muted text-xs">Servicio</dt>
                <dd class="text-text mt-1 font-medium">{service}</dd>
              </div>
            )
          }

          <div>
            <dt class="text-text-muted text-xs">Sector</dt>
            <dd class="text-text mt-1 font-medium">
              {sectorsTranslations.items[sector].title}
            </dd>
          </div>
        </dl>

        <button
          type="button"
          class="group relative block w-full cursor-zoom-in overflow-hidden rounded-3xl text-left"
          data-lightbox-trigger={lightboxId}
          data-lightbox-index="0"
          aria-label={`Abrir imagen: ${coverAlt}`}
        >
          <Image
            src={cover}
            alt={coverAlt}
            class="aspect-4/3 max-h-170 w-full object-cover transition duration-500 group-hover:scale-[1.03]"
            loading="eager"
          />

          <span
            class="pointer-events-none absolute inset-0 bg-black/0 transition duration-300 group-hover:bg-black/15"
          ></span>

          <span
            class="pointer-events-none absolute right-4 bottom-4 rounded-full bg-black/70 px-4 py-2 text-sm font-semibold text-white opacity-0 transition duration-300 group-hover:opacity-100"
          >
            Ver galería
          </span>
        </button>
      </aside>

      <div class="prose prose-content-text max-w-none md:pt-1">
        <Content />
      </div>
    </section>

    {
      gallery.length > 0 && (
        <section class="mx-auto max-w-6xl px-4 pb-20">
          <SectionTitle titleTag="h2" title={t('projects.gallery')} />

          <div class="grid gap-5 sm:grid-cols-2">
            {galleryItems.map((item, index) => (
              <button
                type="button"
                class="group relative block cursor-zoom-in overflow-hidden rounded-3xl text-left"
                data-lightbox-trigger={lightboxId}
                data-lightbox-index={index + 1}
                aria-label={`Abrir imagen: ${item.alt}`}
              >
                <Image
                  src={item.image}
                  alt={item.alt}
                  class="aspect-4/3 w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                />

                <span class="pointer-events-none absolute inset-0 bg-black/0 transition duration-300 group-hover:bg-black/15" />

                <span class="pointer-events-none absolute right-4 bottom-4 rounded-full bg-black/70 px-4 py-2 text-sm font-semibold text-white opacity-0 transition duration-300 group-hover:opacity-100">
                  Ampliar
                </span>
              </button>
            ))}
          </div>
        </section>
      )
    }

    <ProjectServiceLinks
      project={project}
      services={allServices}
      class="mx-auto max-w-6xl px-6 lg:px-12"
    />

    <RelatedProjects
      title={t('projects.relatedProjects')}
      projects={relatedProjects}
      viewAllHref={trPath(`projects/`)}
      viewAllLabel={t('projects.viewAll')}
    />

    <div class="mx-auto max-w-6xl px-4 pb-20">
      <ContactCta />
    </div>
  </article>

  <Lightbox id={lightboxId} images={lightboxImages} />
</Layout>
