---
import BlogLayout from '@layouts/BlogLayout.astro';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  coverImage?: any;
  coverAlt?: string;
  Content: any;
  readingTime?: number;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  coverImage,
  coverAlt,
  Content,
  readingTime,
} = Astro.props;
---

<BlogLayout
  title={title}
  description={description}
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
  coverImage={coverImage}
  coverAlt={coverAlt}
  readingTime={readingTime}
>
  <Content />
</BlogLayout>
